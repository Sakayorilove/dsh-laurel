{
  "name": "laurel-center",
  "version": "1.2.0",
  "private": true,
  "description": "Laurel 控制中心：在 DeepSeek Harness 内统一管理通知、主题、记忆、护栏与规划五个模块，支持拖动、调整大小和最大化。",
  "license": "MIT",
  "author": "Clelia",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sakayorilove/dsh-laurel.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "packages",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "laurel",
    "launcher",
    "bundle"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:client:check": "node scripts/build-client.mjs --check",
    "test": "node scripts/check.mjs",
    "test:all": "node scripts/check.mjs && node scripts/integration-probe.mjs && node scripts/bootgraph-probe.mjs",
    "test:e2e": "node scripts/e2e-real-cordis.mjs",
    "verify:installed": "node scripts/verify-installed.mjs",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "laurel": "file:./packages/laurel",
    "dsh-claude-parchment": "file:./packages/dsh-claude-parchment",
    "dsh-strata": "file:./packages/dsh-strata",
    "dsh-warden": "file:./packages/dsh-warden",
    "dsh-loom": "file:./packages/dsh-loom"
  }
}
