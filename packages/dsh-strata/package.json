{
  "name": "dsh-strata",
  "version": "0.3.1",
  "description": "给 DSH 补上跨会话记忆：作用域是三级阶梯（本会话 → 本工作区 → 全局），跨工作区读取要逐工作区授权，授权记在可审计的台账里。另含上下文领航：增长式提醒 + 已核实文件台账（借自 ACP）。",
  "license": "MIT",
  "author": "Clelia",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sakayorilove/dsh-laurel.git",
    "directory": "packages/dsh-strata"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "使用说明.md",
    "设计说明.md",
    "验证记录.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "cross-session",
    "recall"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node tests/smoke.mjs && node tests/regression.mjs && node tests/context-pilot.mjs && node tests/human-source.mjs",
    "test:installed": "node tests/installed.mjs",
    "test:mutate": "node tests/probes/strata-mutate.mjs",
    "build": "node scripts/build-client.mjs --entry lib/client/index.mjs --out lib/client.js --id dsh-strata --strip-comments",
    "build:check": "node scripts/build-client.mjs --entry lib/client/index.mjs --out lib/client.js --id dsh-strata --strip-comments --check",
    "test:ui": "node tests/ui.mjs",
    "preview:widget": "node tests/probes/widget-preview.mjs",
    "test:human": "node tests/human-source.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
