{
  "name": "dsh-claude-parchment",
  "version": "1.3.1",
  "description": "Parchment and minimal Robinhood, Binance and Bitget inspired light/dark themes for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "Clelia",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sakayorilove/dsh-laurel.git",
    "directory": "packages/dsh-claude-parchment"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "preview": "node scripts/preview.mjs"
  }
}