{
  "version": 1,
  "note": "通用规则：与本机身份无关的敏感模式。可以在 <repo>/.privacy-allow 或 local.rules.json 的 allowPatterns 里豁免误报。",
  "allowPatterns": [
    "(?i)\\b(?:0\\.0\\.0\\.0|127\\.0\\.0\\.1|localhost)\\b",
    "(?i)\\b[A-Za-z0-9._%+-]+@example\\.(?:com|org|net)\\b",
    "(?i)\\bexample\\.(?:com|org|net)\\b",
    "<[A-Za-z_-]*(?:USER|user|NAME|name|HOME|home|EMAIL|email|HOST|host|REPO|repo|TOKEN|token|KEY|key|SECRET|secret|PATH|path)[A-Za-z_-]*>",
    "(?i)\\b(?:your|my|the)[_-]?(?:api[_-]?key|token|secret|password|username|name|path|email|host)\\b",
    "^[A-Za-z]:[\\\\/]{1,2}Users[\\\\/]{1,2}(?:fixture|example|user|test|runner|you|your[-_]?name)(?:$|[\\\\/])",
    "^/(?:home|Users)/(?:x|y|z|u|a|user|test|fixture|example|\\.\\.\\.)(?:$|/)",
    "^[A-Za-z0-9._%+-]+@(?:[A-Za-z0-9-]+\\.)*(?:local|test|invalid|example)$",
    "^(?:[A-Za-z0-9-]+\\.)+(?:local|test|invalid)$",
    "^/tmp(?:/|$)"
  ],
  "rules": [
    {
      "id": "private-key-block",
      "severity": "high",
      "description": "PEM 私钥块",
      "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
    },
    {
      "id": "aws-access-key-id",
      "severity": "high",
      "description": "AWS Access Key ID",
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
    },
    {
      "id": "generic-api-key",
      "severity": "high",
      "description": "sk-/rk-/pk- 形式的 API Key",
      "pattern": "\\b(?:sk|rk|pk)-[A-Za-z0-9_-]{20,}\\b"
    },
    {
      "id": "github-token",
      "severity": "high",
      "description": "GitHub Token",
      "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})\\b"
    },
    {
      "id": "slack-token",
      "severity": "high",
      "description": "Slack Token",
      "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b"
    },
    {
      "id": "google-api-key",
      "severity": "high",
      "description": "Google API Key",
      "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b"
    },
    {
      "id": "win-user-path",
      "severity": "high",
      "fixable": true,
      "placeholder": "<WINDOWS-USER>",
      "description": "Windows 绝对路径中的本机用户名",
      "pattern": "[A-Za-z]:\\\\{1,2}Users\\\\{1,2}[A-Za-z0-9._-]+"
    },
    {
      "id": "password-assign",
      "severity": "medium",
      "description": "代码里写死的密码/密钥",
      "pattern": "\\b(?:passwd|password|pwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token)\\b\\s*[:=]\\s*[\"'][^\"'\\n]{8,}[\"']",
      "flags": "i"
    },
    {
      "id": "jwt",
      "severity": "medium",
      "description": "JWT",
      "pattern": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b"
    },
    {
      "id": "unix-home-path",
      "severity": "medium",
      "fixable": true,
      "placeholder": "<HOME-USER>",
      "description": "Unix 家目录中的用户名",
      "pattern": "/(?:home|Users)/[A-Za-z0-9._-]+"
    },
    {
      "id": "email",
      "severity": "medium",
      "description": "邮箱地址",
      "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b"
    },
    {
      "id": "private-ip",
      "severity": "medium",
      "description": "内网 IP（四段完整地址）",
      "pattern": "\\b(?:10(?:\\.\\d{1,3}){3}|192\\.168(?:\\.\\d{1,3}){2}|172\\.(?:1[6-9]|2\\d|3[01])(?:\\.\\d{1,3}){2})\\b"
    },
    {
      "id": "internal-host",
      "severity": "medium",
      "flags": "gi",
      "description": "内网域名后缀",
      "pattern": "(?<![\\w.-])(?:[a-z0-9][a-z0-9-]*\\.)+(?:local|lan|internal|corp|intra)\\b"
    },
    {
      "id": "cn-mobile",
      "severity": "medium",
      "description": "中国大陆手机号",
      "pattern": "(?<!\\d)1[3-9]\\d{9}(?!\\d)"
    },
    {
      "id": "cn-id-card",
      "severity": "medium",
      "description": "中国大陆身份证号",
      "pattern": "(?<!\\d)\\d{17}[\\dXx](?!\\d)"
    },
    {
      "id": "mac-address",
      "severity": "low",
      "description": "MAC 地址（设备指纹）",
      "pattern": "\\b(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\\b"
    },
    {
      "id": "escaped-cjk-path",
      "severity": "medium",
      "description": "十六进制转义的非 ASCII 路径段（常见于会话目录名），明文正则扫不到但能还原出本机路径",
      "pattern": "(?:~[0-9A-Fa-f]{4}){2,}"
    }
  ]
}
